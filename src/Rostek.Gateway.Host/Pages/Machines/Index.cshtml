@page
@model Rostek.Gateway.Host.Pages.Machines.IndexModel
@{
    ViewData["Title"] = "Machines";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Machines</h1>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="SetAllEnabled" onsubmit="return confirm('Enable all machines in draft configuration?');">
            <input type="hidden" name="enabled" value="true" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <button class="btn btn-outline-success" type="submit">Enable All</button>
        </form>
        <form method="post" asp-page-handler="SetAllEnabled" onsubmit="return confirm('Disable all machines in draft configuration?');">
            <input type="hidden" name="enabled" value="false" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <button class="btn btn-outline-danger" type="submit">Disable All</button>
        </form>
        <a class="btn btn-primary" asp-page="Edit">New Machine</a>
    </div>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="search" value="@Model.Search" class="form-control" placeholder="Search code/name" /></div>
    <div class="col-md-2"><button class="btn btn-secondary" type="submit">Filter</button></div>
</form>
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
<table class="table table-sm table-striped">
    <thead><tr><th>Code</th><th>Name</th><th>Group</th><th>Template</th><th>Protocol</th><th>Endpoint/IP</th><th>Enabled</th><th></th></tr></thead>
    <tbody>
    @foreach (var machine in Model.Machines.Items)
    {
        <tr>
            <td>@machine.Code</td>
            <td>@machine.Name</td>
            <td>@machine.GroupCode</td>
            <td>@machine.TemplateCode</td>
            <td>@machine.Protocol</td>
            <td>@machine.Endpoint</td>
            <td>
                <form method="post" asp-page-handler="ToggleEnabled" class="d-inline-flex align-items-center">
                    <input type="hidden" name="id" value="@machine.Id" />
                    <input type="hidden" name="enabled" value="@machine.Enabled.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input machine-enabled-switch"
                               type="checkbox"
                               role="switch"
                               checked="@machine.Enabled"
                               aria-label="@(machine.Enabled ? $"Disable {machine.Code}" : $"Enable {machine.Code}")"
                               title="@(machine.Enabled ? "Enabled" : "Disabled")"
                               onchange="this.form.elements['enabled'].value = this.checked.toString(); this.form.submit();" />
                    </div>
                </form>
            </td>
            <td class="text-end">
                <a class="btn btn-link btn-sm" asp-page="Edit" asp-route-id="@machine.Id">Edit</a>
                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Delete machine @machine.Code from draft configuration?');">
                    <input type="hidden" name="id" value="@machine.Id" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <button class="btn btn-link btn-sm text-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<style>
    .form-switch .machine-enabled-switch {
        width: 4.25rem;
        height: 1.75rem;
        border-radius: 2rem;
        margin-top: 0;
        cursor: pointer;
    }
</style>
