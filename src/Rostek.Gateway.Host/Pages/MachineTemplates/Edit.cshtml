@page "{id:guid?}"
@model Rostek.Gateway.Host.Pages.MachineTemplates.EditModel
@{
    ViewData["Title"] = "Machine Template";
}
<h1 class="h3">Machine Template</h1>
<form method="post" class="row g-3">
    <input asp-for="Input.Id" type="hidden" />
    <div class="col-md-3"><label class="form-label">Code</label><input asp-for="Input.Code" class="form-control" /></div>
    <div class="col-md-5"><label class="form-label">Name</label><input asp-for="Input.Name" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">Protocol</label><select asp-for="Input.Protocol" asp-items="Html.GetEnumSelectList<GatewayProtocol>()" class="form-select"></select></div>
    <div class="col-md-2"><label class="form-label">Polling ms</label><input asp-for="Input.DefaultPollingIntervalMs" class="form-control" /></div>
    <div class="col-12 row g-3" id="net100ProfileFields">
        <div class="col-md-5"><label class="form-label">NET100 Server IP / Host</label><input asp-for="Input.Net100ServerHost" class="form-control" placeholder="172.20.20.5" /></div>
        <div class="col-md-2"><label class="form-label">NET100 Port</label><input asp-for="Input.Net100ServerPort" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">NET100 Base Path</label><input asp-for="Input.Net100BasePath" class="form-control" placeholder="/net100" /></div>
        <div class="col-md-2">
            <label class="form-label">Authentication</label>
            <select asp-for="Input.Net100AuthenticationMode" class="form-select" id="net100AuthenticationMode">
                <option value="NONE">None</option>
                <option value="BASIC">Basic</option>
            </select>
        </div>
        <div class="col-md-5" id="net100CredentialReferenceField">
            <label class="form-label">Credential Reference</label>
            <input asp-for="Input.Net100CredentialReference" class="form-control" placeholder="jsw-main" />
            <div class="form-text">Username and password are read from external appsettings, not stored in the config database.</div>
        </div>
    </div>
    <div class="col-md-3"><label class="form-label">Manufacturer</label><input asp-for="Input.Manufacturer" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">Model</label><input asp-for="Input.Model" class="form-control" /></div>
    <div class="col-md-2 form-check mt-5"><input asp-for="Input.Enabled" class="form-check-input" /><label class="form-check-label">Enabled</label></div>
    <div class="col-12"><label class="form-label">Description</label><textarea asp-for="Input.Description" class="form-control"></textarea></div>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="col-12 text-danger">@Model.ErrorMessage</div>
    }
    <div class="col-12">
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-secondary" asp-page="Index">Cancel</a>
    </div>
</form>
@if (Model.Input.Id is not null && Model.Input.Protocol == GatewayProtocol.Net100Http)
{
    <h2 class="h5 mt-4">Assigned NET100 Machines</h2>
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead><tr><th>Code</th><th>Name</th><th>Machine Address</th><th>Enabled</th><th></th></tr></thead>
            <tbody>
            @foreach (var machine in Model.AssignedMachines)
            {
                <tr>
                    <td>@machine.Code</td>
                    <td>@machine.Name</td>
                    <td>@machine.Endpoint</td>
                    <td>@machine.Enabled</td>
                    <td class="text-end"><a asp-page="/Machines/Edit" asp-route-id="@machine.Id">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const protocol = document.getElementById('Input_Protocol');
            const fields = document.getElementById('net100ProfileFields');
            const authenticationMode = document.getElementById('net100AuthenticationMode');
            const credentialReferenceField = document.getElementById('net100CredentialReferenceField');
            const net100Value = '@((int)GatewayProtocol.Net100Http)';
            const update = () => {
                fields?.classList.toggle('d-none', protocol?.value !== net100Value);
                credentialReferenceField?.classList.toggle('d-none', authenticationMode?.value !== 'BASIC');
            };
            protocol?.addEventListener('change', update);
            authenticationMode?.addEventListener('change', update);
            update();
        })();
    </script>
}
